{
  "Security": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100
  },
  "Pdf": {
    "TemplatesPath": "Templates",
    "DefaultFontFamily": "Arial",
    "Chromium": {
      "ExecutablePath": null,
      "MaxConcurrency": 4,
      "TimeoutSeconds": 30,
      "AllowExternalResources": false
    },
    "Gotenberg": {
      "BaseUrl": "http://localhost:3001",
      "TimeoutSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
